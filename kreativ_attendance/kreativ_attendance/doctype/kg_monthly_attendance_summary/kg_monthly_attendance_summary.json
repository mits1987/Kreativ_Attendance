{
  "actions": [],
  "allow_import": 1,
  "autoname": "format:KG-MAS-{period_year}-{period_month}-{employee}",
  "creation": "2026-07-31 10:00:00.000000",
  "doctype": "DocType",
  "editable_grid": 1,
  "engine": "InnoDB",
  "module": "Kreativ Attendance",
  "name": "KG Monthly Attendance Summary",
  "owner": "Administrator",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "field_order": [
    "employee",
    "employee_name",
    "department",
    "column_break_head",
    "period_year",
    "period_month",
    "period",
    "status",
    "calendar_section",
    "days_in_month",
    "wd",
    "wo",
    "column_break_cal",
    "ph",
    "holiday_list",
    "hours_section",
    "standard_hours",
    "required_hours",
    "total_hours",
    "column_break_hours",
    "shift_count",
    "anomaly_count",
    "hours_source",
    "result_section",
    "pd",
    "pay_days",
    "column_break_result",
    "ot_hours",
    "rate_of_wages",
    "ot_amount",
    "audit_section",
    "computed_at",
    "computed_by",
    "column_break_audit",
    "reviewed_at",
    "reviewed_by",
    "notes"
  ],
  "fields": [
    {"fieldname": "employee", "fieldtype": "Link", "options": "Employee", "reqd": 1, "label": "Employee", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "employee_name", "fieldtype": "Read Only", "fetch_from": "employee.employee_name", "label": "Employee Name", "in_list_view": 1},
    {"fieldname": "department", "fieldtype": "Read Only", "fetch_from": "employee.department", "label": "Department", "in_standard_filter": 1},
    {"fieldname": "column_break_head", "fieldtype": "Column Break"},
    {"fieldname": "period_year", "fieldtype": "Int", "reqd": 1, "label": "Year", "in_standard_filter": 1},
    {"fieldname": "period_month", "fieldtype": "Int", "reqd": 1, "label": "Month (1-12)", "in_standard_filter": 1},
    {"fieldname": "period", "fieldtype": "Data", "read_only": 1, "label": "Period", "in_list_view": 1},
    {
      "fieldname": "status", "fieldtype": "Select",
      "options": "Draft\nReviewed\nLocked",
      "default": "Draft", "reqd": 1, "bold": 1, "label": "Status",
      "in_list_view": 1, "in_standard_filter": 1,
      "description": "Draft rows are rebuilt on every recalculation. Reviewed and Locked rows are never overwritten."
    },

    {"fieldname": "calendar_section", "fieldtype": "Section Break", "label": "Calendar (from Holiday List)"},
    {"fieldname": "days_in_month", "fieldtype": "Int", "read_only": 1, "label": "Days in Month", "description": "Calendar days. This is the proration divisor."},
    {"fieldname": "wd", "fieldtype": "Float", "precision": "2", "label": "WD (Working Days)"},
    {"fieldname": "wo", "fieldtype": "Float", "precision": "2", "label": "WO (Weekly Offs)"},
    {"fieldname": "column_break_cal", "fieldtype": "Column Break"},
    {"fieldname": "ph", "fieldtype": "Float", "precision": "2", "default": "0", "label": "PH (Public Holidays)"},
    {"fieldname": "holiday_list", "fieldtype": "Link", "options": "Holiday List", "read_only": 1, "label": "Holiday List Used"},

    {"fieldname": "hours_section", "fieldtype": "Section Break", "label": "Hours Worked"},
    {"fieldname": "standard_hours", "fieldtype": "Float", "precision": "2", "label": "Standard Hours / Day"},
    {"fieldname": "required_hours", "fieldtype": "Float", "precision": "2", "read_only": 1, "label": "Required Hours", "description": "WD x Standard Hours"},
    {"fieldname": "total_hours", "fieldtype": "Float", "precision": "2", "label": "Total Hours Worked", "description": "Sum of all paired shifts in the period."},
    {"fieldname": "column_break_hours", "fieldtype": "Column Break"},
    {"fieldname": "shift_count", "fieldtype": "Int", "read_only": 1, "label": "Paired Shifts"},
    {"fieldname": "anomaly_count", "fieldtype": "Int", "read_only": 1, "label": "Unresolved Anomalies", "description": "Must be zero. Each anomaly is unpaid time."},
    {"fieldname": "hours_source", "fieldtype": "Data", "read_only": 1, "label": "Standard Hours Source"},

    {"fieldname": "result_section", "fieldtype": "Section Break", "label": "Payroll Figures"},
    {"fieldname": "pd", "fieldtype": "Float", "precision": "2", "bold": 1, "label": "PD (Present Days)", "in_list_view": 1, "description": "min(WD, Total Hours / Standard Hours), to nearest 0.5"},
    {"fieldname": "pay_days", "fieldtype": "Float", "precision": "2", "bold": 1, "read_only": 1, "label": "Pay Days", "in_list_view": 1, "description": "PD + WO + PH"},
    {"fieldname": "column_break_result", "fieldtype": "Column Break"},
    {"fieldname": "ot_hours", "fieldtype": "Float", "precision": "2", "label": "Overtime Hours", "description": "max(0, Total Hours - Required Hours). Non-zero only when PD is at its cap."},
    {"fieldname": "rate_of_wages", "fieldtype": "Currency", "read_only": 1, "label": "Rate of Wages", "description": "Basic + HRA + Conveyance + Medical + Other, from the Salary Structure Assignment."},
    {"fieldname": "ot_amount", "fieldtype": "Currency", "read_only": 1, "label": "Overtime Amount", "in_list_view": 1},

    {"fieldname": "audit_section", "fieldtype": "Section Break", "label": "Audit"},
    {"fieldname": "computed_at", "fieldtype": "Datetime", "read_only": 1, "label": "Computed At"},
    {"fieldname": "computed_by", "fieldtype": "Link", "options": "User", "read_only": 1, "label": "Computed By"},
    {"fieldname": "column_break_audit", "fieldtype": "Column Break"},
    {"fieldname": "reviewed_at", "fieldtype": "Datetime", "read_only": 1, "label": "Reviewed At"},
    {"fieldname": "reviewed_by", "fieldtype": "Link", "options": "User", "read_only": 1, "label": "Reviewed By"},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
    {"role": "HR Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
    {"role": "HR User", "read": 1, "write": 1, "report": 1, "export": 1}
  ],
  "show_name_in_global_search": 1
}
